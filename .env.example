# 复制这份成 .env 再填值。变量名请照抄 —— 名字写错不会报错，只会静默失效。
#
#   cp .env.example .env          # macOS / Linux
#   copy .env.example .env        # Windows

# 模型凭据
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_API_BASE_URL=https://your-endpoint-here/v1

# agent 的沙箱根目录：
#   删掉这一行 / 留空  -> 就是运行程序的目录（默认）
#   设成子目录名        -> 运行目录 + 该子目录，比如 workspace
#   设成绝对路径        -> 直接用那个路径，前面不再拼运行目录
JCA_WORKSPACE=workspace

# 日志（详见 README 的 Logging 一节）。默认只输出到终端。
#
# 例外：交互式界面（`uv run main.py` 不带参数）默认改成 file —— 界面要在终端上
# 做重绘，日志也写终端会互相抢光标。这里**没设**才会走那个默认；一旦设了，
# 就按设的来（设成 console 时界面里会提醒一句）。`--prompt` 模式不受影响。
# JCA_LOG_TARGET=both          # console / file / both
# JCA_LOG_LEVEL=INFO           # DEBUG / INFO / WARNING / ERROR
# JCA_LOG_DIR=logs             # 相对运行目录；建议不要放进沙箱
# JCA_LOG_FILE=jca.log
# JCA_LOG_MAX_BYTES=10485760
# JCA_LOG_BACKUP_COUNT=5

# 界面符号退化成纯 ASCII。老终端显示不出来 ⏺ ⎿ 会变成问号时用。
# JCA_ASCII=1
